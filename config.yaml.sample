# Liste des flux RSS à surveiller.
# Chaque entrée peut être une simple URL (hashtag par défaut)
# ou un objet avec une URL, un hashtag propre au flux et un nombre
# d'items à publier (count, par défaut 1 : l'article le plus récent).
feeds:
  - "https://url-flux-rss.com/"
  - url: "https://autre-flux-rss.com/feed"
    hashtag: "#AutreFlux"
    count: 3

bluesky:
  handle: "identifiant bluesky"
  password: "mot de passe bluesky"
  
post:
  # Hashtag par défaut, utilisé pour les flux sans hashtag dédié
  hashtag: "#ActuDeMonFluxRSS"

cache:
  file: "rss_cache.json"
